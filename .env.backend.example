# PostgreSQL container
POSTGRES_DB=charging_app
POSTGRES_USER=charging_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# NestJS API
NODE_ENV=production
API_PORT=3001
DATABASE_URL=postgresql://charging_user:replace_with_a_strong_database_password@postgres:5432/charging_app
REDIS_URL=redis://redis:6379

# Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Public frontend address
FRONTEND_URL=https://app.example.com

# Reservation jobs
NO_SHOW_GRACE_MINUTES=15

# Email provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=noreply@example.com
